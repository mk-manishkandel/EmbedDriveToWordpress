{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "embed-drive/module",
	"title": "FileFolio",
	"category": "embed",
	"icon": "cloud",
	"description": "Show a Google Drive folder or file: file browser, photo gallery, search, embed, or a download button or link.",
	"keywords": [ "google", "drive", "files", "download" ],
	"textdomain": "filefolio",
	"supports": { "html": false, "align": [ "wide", "full" ] },
	"attributes": {
		"mode": { "type": "string", "default": "files" },
		"account": { "type": "string", "default": "" },
		"folder": { "type": "string", "default": "" },
		"file": { "type": "string", "default": "" },
		"targetName": { "type": "string", "default": "" },
		"view": { "type": "string", "default": "grid" },
		"sort": { "type": "string", "default": "name" },
		"order": { "type": "string", "default": "asc" },
		"download": { "type": "boolean" },
		"zip": { "type": "boolean", "default": true },
		"search": { "type": "boolean", "default": true },
		"preview": { "type": "boolean", "default": true },
		"label": { "type": "string", "default": "" },
		"height": { "type": "number", "default": 600 },
		"min_height": { "type": "number", "default": 0 }
	},
	"editorScript": "file:./index.js",
	"style": "embed-drive"
}
